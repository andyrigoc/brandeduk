{
  "version": 2,
  "name": "branded-uk-fork-v10",
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,

  "functions": {
    "api/upload-logo.js": {
      "maxDuration": 15
    },
    "api/quotes/stripe/payment-intent.js": {
      "maxDuration": 10
    },
    "api/quotes/submit.js": {
      "maxDuration": 10
    },
    "api/sample-color.js": {
      "maxDuration": 10
    }
  },

  "rewrites": [
    { "source": "/", "destination": "/index.html" },

    { "source": "/m", "destination": "/index-mobile.html" },
    { "source": "/home", "destination": "/home-pc.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/shop-pc", "destination": "/shop-pc.html" },

    { "source": "/basket", "destination": "/basket.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/quote-review", "destination": "/quote-review.html" },
    { "source": "/auth/callback", "destination": "/auth/callback.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/orders", "destination": "/orders.html" },
    { "source": "/order-detail", "destination": "/order-detail.html" },
    { "source": "/track-order", "destination": "/track-order.html" },
    { "source": "/payment-success", "destination": "/payment-success.html" },
    { "source": "/payment-cancel", "destination": "/payment-cancel.html" },
    { "source": "/customize", "destination": "/customize.html" },
    { "source": "/services", "destination": "/services.html" },

    { "source": "/hospitality-workwear", "destination": "/hospitality-workwear.html" },
    { "source": "/construction-workwear", "destination": "/construction-workwear.html" },
    { "source": "/corporate-uniforms", "destination": "/corporate-uniforms.html" },

    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/terms-and-conditions.html" },

    { "source": "/product", "destination": "/product-detail.html" },
    { "source": "/product/:code", "destination": "/product-detail.html" },

    { "source": "/polos", "destination": "/polos.html" },
    { "source": "/hoodies", "destination": "/hoodies.html" },
    { "source": "/tshirts", "destination": "/tshirts.html" },
    { "source": "/hivis", "destination": "/hivis.html" },
    { "source": "/workwear", "destination": "/workwear.html" },
    { "source": "/jackets", "destination": "/jackets.html" },
    { "source": "/bundles", "destination": "/bundles.html" },
    { "source": "/bulk-orders", "destination": "/bulk-orders.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/embroidery", "destination": "/embroidery.html" },
    { "source": "/screen-printing", "destination": "/screen-printing.html" },
    { "source": "/dtf-printing", "destination": "/dtf-printing.html" },
    { "source": "/dtg-printing", "destination": "/dtg-printing.html" },
    { "source": "/school-uniforms", "destination": "/school-uniforms.html" },
    { "source": "/sports-teamwear", "destination": "/sports-teamwear.html" },
    { "source": "/outdoor-workwear", "destination": "/outdoor-workwear.html" }
  ],

  "redirects": [
    { "source": "/quote", "destination": "/?contact=1", "permanent": false },
    { "source": "/quote-form", "destination": "/?contact=1", "permanent": false },
    { "source": "/quote-form.html", "destination": "/?contact=1", "permanent": false },
    { "source": "/brandeduk.com/quote-form-pc", "destination": "/?contact=1", "permanent": false },
    { "source": "/brandeduk.com/quote-form-pc.html", "destination": "/?contact=1", "permanent": false },
    { "source": "/contact/", "destination": "/contact", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/embroidery/", "destination": "/embroidery", "permanent": true },
    { "source": "/printing", "destination": "/services", "permanent": false },
    { "source": "/printing/", "destination": "/services", "permanent": false },
    { "source": "/screen-printing/", "destination": "/screen-printing", "permanent": true },
    { "source": "/dtf-printing/", "destination": "/dtf-printing", "permanent": true },
    { "source": "/dtg-printing/", "destination": "/dtg-printing", "permanent": true },
    { "source": "/school-uniforms/", "destination": "/school-uniforms", "permanent": true },
    { "source": "/sports-teamwear/", "destination": "/sports-teamwear", "permanent": true },
    { "source": "/outdoor-workwear/", "destination": "/outdoor-workwear", "permanent": true },
    {
      "source": "/mobile",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop.html",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/polos.html",
      "destination": "/polos",
      "permanent": true
    },
    {
      "source": "/hoodies.html",
      "destination": "/hoodies",
      "permanent": true
    },
    {
      "source": "/tshirts.html",
      "destination": "/tshirts",
      "permanent": true
    },
    {
      "source": "/hivis.html",
      "destination": "/hivis",
      "permanent": true
    },
    {
      "source": "/workwear.html",
      "destination": "/workwear",
      "permanent": true
    },
    {
      "source": "/jackets.html",
      "destination": "/jackets",
      "permanent": true
    },
    {
      "source": "/bundles.html",
      "destination": "/bundles",
      "permanent": true
    },
    {
      "source": "/bulk-orders.html",
      "destination": "/bulk-orders",
      "permanent": true
    },
    {
      "source": "/basket.html",
      "destination": "/basket",
      "permanent": true
    },
    {
      "source": "/checkout.html",
      "destination": "/checkout",
      "permanent": true
    },
    {
      "source": "/profile.html",
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/orders.html",
      "destination": "/orders",
      "permanent": true
    },
    {
      "source": "/order-detail.html",
      "destination": "/order-detail",
      "permanent": true
    },
    {
      "source": "/track-order.html",
      "destination": "/track-order",
      "permanent": true
    },
    {
      "source": "/payment-success.html",
      "destination": "/payment-success",
      "permanent": true
    },
    {
      "source": "/payment-cancel.html",
      "destination": "/payment-cancel",
      "permanent": true
    },
    {
      "source": "/customize.html",
      "destination": "/customize",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/hospitality-workwear.html",
      "destination": "/hospitality-workwear",
      "permanent": true
    },
    {
      "source": "/construction-workwear.html",
      "destination": "/construction-workwear",
      "permanent": true
    },
    {
      "source": "/corporate-uniforms.html",
      "destination": "/corporate-uniforms",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions.html",
      "destination": "/terms-and-conditions",
      "permanent": true
    },
    {
      "source": "/product-detail.html",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/shop/product-detail.html",
      "destination": "/product",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}

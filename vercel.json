{
  "version": 2,
  "name": "branded-uk-fork-v10",
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,

  "rewrites": [
    { "source": "/", "destination": "/index.html" },

    { "source": "/m", "destination": "/index-mobile.html" },
    { "source": "/home", "destination": "/home-pc.html" },
    { "source": "/shop", "destination": "/shop-pc.html" },

    { "source": "/basket", "destination": "/basket.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/customize", "destination": "/customize.html" },
    { "source": "/quote", "destination": "/quote-form.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/catalogue", "destination": "/catalogue.html" },
    { "source": "/catalogue2", "destination": "/catalogue2.html" },

    { "source": "/product", "destination": "/product-detail.html" },
    { "source": "/product/:code", "destination": "/product-detail.html" }
  ],

  "redirects": [
    {
      "source": "/mobile",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop-pc.html",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/basket.html",
      "destination": "/basket",
      "permanent": true
    },
    {
      "source": "/checkout.html",
      "destination": "/checkout",
      "permanent": true
    },
    {
      "source": "/customize.html",
      "destination": "/customize",
      "permanent": true
    },
    {
      "source": "/quote-form.html",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/catalogue.html",
      "destination": "/catalogue",
      "permanent": true
    },
    {
      "source": "/catalogue2.html",
      "destination": "/catalogue2",
      "permanent": true
    },
    {
      "source": "/product-detail.html",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/shop/product-detail.html",
      "destination": "/product",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}

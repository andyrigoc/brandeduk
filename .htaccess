# Apache Configuration - Set index.html as default
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^blog$ /blog/ [R=301,L]
    RewriteRule ^terms-and-conditions/?$ /terms-and-conditions.html [L]
    RewriteRule ^privacy-policy/?$ /privacy-policy.html [L]
</IfModule>

# Disable directory listing
Options -Indexes

# Allow access to all HTML files
<FilesMatch "\.(html|htm)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Prevent directory listing for sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

